# The HDR mode's shaders, put into the executable at configure time
# (render_d3d11.cpp compiles them at run time; hdr_shaders.h):
#
#   cod3_hdr.hlsl          this folder's, the port's passes
#   renodx/...             thirdparty/renodx/hlsl, RenoDX's shader library (MIT)
#   prism/prismTM.hlsl     thirdparty/prism, the Prism tone mapper (MIT)
#
# Written as byte arrays, which no compiler limits the length of, into
# hdr_shader_files.cpp in the build folder; rewritten only when its text
# changes, and CMake runs again when any of the files does.
#
# In: COD3_HDR_EMBED_OUTPUT, the .cpp to write. Out: nothing else.

set(hdrRoot "${CMAKE_CURRENT_LIST_DIR}")
set(thirdParty "${CMAKE_CURRENT_LIST_DIR}/../../thirdparty")

set(hdrNames "cod3_hdr.hlsl")
set(hdrPaths "${hdrRoot}/cod3_hdr.hlsl")
file(GLOB_RECURSE renodxFiles RELATIVE "${thirdParty}/renodx/hlsl" CONFIGURE_DEPENDS "${thirdParty}/renodx/hlsl/*.hlsl")
list(SORT renodxFiles)
foreach(relative ${renodxFiles})
    list(APPEND hdrNames "renodx/${relative}")
    list(APPEND hdrPaths "${thirdParty}/renodx/hlsl/${relative}")
endforeach()
list(APPEND hdrNames "prism/prismTM.hlsl")
list(APPEND hdrPaths "${thirdParty}/prism/prismTM.hlsl")

set(text "// Generated by CoD3Host/hdr/embed_shaders.cmake from cod3_hdr.hlsl and\n")
string(APPEND text "// thirdparty/renodx and thirdparty/prism (MIT; see the LICENSE files there).\n")
string(APPEND text "#include <cstddef>\n\nnamespace HdrShaders\n{\n    struct File { const char* name; const unsigned char* data; size_t size; };\n}\n\nnamespace\n{\n")
set(table "")
list(LENGTH hdrNames count)
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
    list(GET hdrNames ${index} name)
    list(GET hdrPaths ${index} path)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    file(READ "${path}" hex HEX)
    string(LENGTH "${hex}" hexLength)
    math(EXPR size "${hexLength} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # Lines of a reasonable length for the compiler's sake.
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" bytes "${bytes}")
    string(APPEND text "    const unsigned char file${index}[] = {\n${bytes}0x00 };\n")
    string(APPEND table "    { \"${name}\", file${index}, ${size} },\n")
endforeach()
string(APPEND text "}\n\nnamespace HdrShaders\n{\n    extern const File Files[] = {\n${table}    };\n    extern const size_t FileCount = ${count};\n}\n")

set(previous "")
if (EXISTS "${COD3_HDR_EMBED_OUTPUT}")
    file(READ "${COD3_HDR_EMBED_OUTPUT}" previous)
endif()
if (NOT previous STREQUAL text)
    file(WRITE "${COD3_HDR_EMBED_OUTPUT}" "${text}")
endif()
message(STATUS "CoD3: ${count} HDR shader files (RenoDX, Prism and the port's) built into the executable")
