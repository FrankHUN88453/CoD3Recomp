 // stands in, so the title can be driven without hardware.
 
 #include <cstdint>
+#include <string>
 
 namespace Input
 {
@@ -42,4 +43,12 @@ namespace Input
 
     // Which keys stand in for which buttons, for the status view to show.
     const char* KeyboardHelp();
+
+    // Which controllers Windows reports, for the settings menu: "none found"
+    // or the XInput slots in use and what they are pressing.
+    std::string ControllerStatus();
+
+    // The title's vibration, sent to every connected pad (0 .. 65535 each
+    // motor, the low frequency one on the left).
+    void SetRumble(uint16_t left, uint16_t right);
 }
diff --git a/kernel_xam.cpp b/kernel_xam.cpp
index 2fd4400..6306a2a 100644
--- a/kernel_xam.cpp
+++ b/kernel_xam.cpp
@@ -292,8 +292,16 @@ PPC_FUNC(__imp__XamInputGetCapabilities)
 PPC_FUNC(__imp__XamInputSetState)
 {
     Kernel::CountImport("XamInputSetState");
-    ctx.r3.u32 = (ctx.r3.u32 == SignedInUser)
-        ? X_ERROR_SUCCESS : X_ERROR_DEVICE_NOT_CONNECTED;
+    if (ctx.r3.u32 != SignedInUser)
+    {
+        ctx.r3.u32 = X_ERROR_DEVICE_NOT_CONNECTED;
+        return;
+    }
+    // XINPUT_VIBRATION: the left (low frequency) motor's speed, then the
+    // right's, big endian. Passed on to the real pad.
+    if (ctx.r5.u32 != 0)
+        Input::SetRumble(Guest::Read16(base, ctx.r5.u32 + 0), Guest::Read16(base, ctx.r5.u32 + 2));
+    ctx.r3.u32 = X_ERROR_SUCCESS;
 }
 
